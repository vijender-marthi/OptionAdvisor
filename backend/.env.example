# OptionAdvisor — Backend Configuration
# Copy this file to .env and fill in your values.
# The backend reads these at startup via os.getenv().

# SQLite database path. On DigitalOcean, point this at the mounted volume.
OPTION_ADVISOR_DB_PATH=/mnt/optionadvisor-data/option_advisor.sqlite3

# If SMTP_USER or SMTP_PASSWORD are empty, alert emails are silently
# skipped — alerts still appear in the app's Alerts page.

# Gmail SMTP (recommended)
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Paste it below (no spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=your-gmail@gmail.com
