# OptionAdvisor — Backend Configuration
# Copy this file to .env and fill in your values.
# The backend reads these at startup via os.getenv().

# SQLite database path. On DigitalOcean, point this at the mounted volume.
OPTION_ADVISOR_DB_PATH=/mnt/optionadvisor-data/option_advisor.sqlite3

# ── Email (choose SendGrid OR SMTP; SendGrid is used first when configured) ──
#
# SendGrid (Twilio) — https://sendgrid.com — create an API key with "Mail Send".
# Verify a single sender (or domain) in SendGrid; use that address as SENDGRID_FROM_EMAIL.
#
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_FROM_EMAIL=alerts@yourdomain.com
# SENDGRID_FROM_NAME=OptionAdvisor
#
# If SENDGRID_API_KEY is not set, the app falls back to SMTP below.

# Gmail SMTP (example)
# If SMTP_USER or SMTP_PASSWORD are empty (and SendGrid is not set), alert emails are skipped.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=your-gmail@gmail.com
