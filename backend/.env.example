# OptionAdvisor — Backend Configuration
# Copy this file to .env and fill in your values.
# The backend reads these at startup via os.getenv().

# SQLite database path. On DigitalOcean, point this at the mounted volume.
OPTION_ADVISOR_DB_PATH=/mnt/optionadvisor-data/option_advisor.sqlite3

# ── Email (choose SendGrid OR SMTP; SendGrid is used first when configured) ──
#
# SendGrid (Twilio) — https://sendgrid.com — create an API key with "Mail Send".
# Verify a single sender (or domain) in SendGrid; use that address as SENDGRID_FROM_EMAIL.
#
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_FROM_EMAIL=alerts@yourdomain.com
# SENDGRID_FROM_NAME=OptionAdvisor
#
# If SENDGRID_API_KEY is not set, the app falls back to SMTP below.

# Default From address if SMTP_FROM, SMTP_USER, and SENDGRID_FROM_EMAIL are all unset.
# Built-in default is adminzetayuai@gmail.com; override for other deployments.
# OPTION_ADVISOR_DEFAULT_FROM_EMAIL=adminzetayuai@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=your-gmail@gmail.com

# ── Auth (JWT + optional Google Sign-In) ─────────────────────────────────────
# Required for email/password and Google login. Generate with: openssl rand -hex 32
OPTION_ADVISOR_JWT_SECRET=
# Local dev only — never in production:
# OPTION_ADVISOR_ALLOW_INSECURE_JWT=1
#
# Same OAuth client ID as frontend VITE_GOOGLE_CLIENT_ID (Google Cloud Console → Web client).
OPTION_ADVISOR_GOOGLE_CLIENT_ID=
#
# SPA base URL for activation & password-reset emails (no trailing slash).
OPTION_ADVISOR_PUBLIC_URL=http://localhost:4200
#
# Optional CORS: comma-separated origins. Defaults to localhost dev ports if unset.
# OPTION_ADVISOR_CORS_ORIGINS=https://yourdomain.com,http://localhost:4200
#
# Allow legacy DB rows without password_hash to set a password on first login (default true).
# OPTION_ADVISOR_LEGACY_PASSWORD_BIND=false

# ── Roles (SQLite user_state.role) ────────────────────────────────────────────
# Admin / standard user / finance are stored per email in user_state.role.
# Promote to admin by updating SQLite (or use your ops tooling); there is no env allow-list for admin.
# Optional: OPTION_ADVISOR_FINANCE_EMAILS=comma@emails → user→finance when DB role is still user.

# Watchlist caps (defaults 15 non-admin, 30 admin — see storage.watchlist_limit_for_role).
# OPTION_ADVISOR_WATCHLIST_MAX_USER=15
# OPTION_ADVISOR_WATCHLIST_MAX_ADMIN=30

# ── Alpaca Paper Trading ──────────────────────────────────────────────────────
# Sign up at https://alpaca.markets and generate paper-trading API keys.
# Paper trading base URL: https://paper-api.alpaca.markets
# These keys are ONLY used for paper trading — never live money.
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
